# Aquest fitxer defineix la configuració principal del backend.
# Permet adaptar connexions, seguretat i serveis externs sense modificar el codi.

# Aquest bloc configura la connexió amb la base de dades de CiMS.
# Conté l’adreça, el port, les credencials i el nom de la base de dades utilitzada.
# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=cims_db

# Aquesta variable permet connectar Cloud Run amb Cloud SQL mitjançant socket Unix.
# En desenvolupament local es deixa buida perquè s’utilitzen DB_HOST i DB_PORT.
INSTANCE_CONNECTION_NAME=

# Aquest bloc defineix la configuració general del servidor.
# Permet indicar el port d’execució i l’entorn on s’està executant el backend.
# Server
PORT=3000
NODE_ENV=development

# Aquest bloc configura l’autenticació amb JWT.
# La clau secreta genera i valida tokens, i l’expiració limita la durada de la sessió.
# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# Aquest bloc controla quins orígens poden fer peticions al backend.
# Separa l’URL pública del frontend dels orígens locals de desenvolupament.
# CORS
FRONTEND_URL=https://cims-web-84caf.web.app
CORS_DEV_ORIGINS=http://localhost:8080,http://localhost:3000

# Aquest bloc configura l’enviament de correus del sistema.
# S’utilitza principalment per enviar enllaços de recuperació de contrasenya.
# Email
SENDGRID_API_KEY=your_sendgrid_api_key
MAIL_FROM=noreply@example.com
APP_URL=http://localhost:3000

# Aquest bloc configura l’emmagatzematge de fotos a Google Cloud Storage.
# Permet guardar imatges d’usuari i d’ascensions fora de la base de dades.
# GCS
GCS_BUCKET_NAME=cims-ascent-photos-prod
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Aquest bloc defineix els criteris de verificació d’ascensions per ubicació.
# Permet ajustar la distància i la precisió mínimes acceptades per validar una captura.
# Ascent verification
ASCENT_VERIFICATION_MAX_DISTANCE_METERS=500
ASCENT_VERIFICATION_MAX_ACCURACY_METERS=100

# Aquest bloc configura la integració meteorològica amb Google Weather API.
# El backend consulta aquest servei per obtenir dades de temps associades als cims.
# Weather
GOOGLE_WEATHER_API_KEY=your_google_weather_api_key
WEATHER_CACHE_TTL_MS=3600000