# Aquest fitxer agrupa la configuració bàsica que necessita el backend per funcionar.
# És rellevant perquè permet adaptar la connexió, el servidor i la seguretat
# sense haver de modificar directament el codi de l’aplicació.

# Aquest bloc defineix les dades necessàries per connectar el backend amb la base de dades.
# Aquí s’indica on es troba, amb quin usuari s’hi accedeix i quin nom té la base de dades utilitzada.
# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=cims_db

# Quan el backend s'executa a Cloud Run i es connecta a Cloud SQL via socket Unix,
# aquesta variable substitueix DB_HOST/DB_PORT i indica la instància de Cloud SQL.
# Format: <PROJECT_ID>:<REGION>:<INSTANCE_NAME>. En desenvolupament local es deixa buida.
INSTANCE_CONNECTION_NAME=

# Aquest bloc configura el comportament general del servidor.
# Permet indicar en quin port s’executa i en quin entorn està funcionant l’aplicació.
# Server
PORT=3000
NODE_ENV=development

# Aquest bloc defineix la configuració relacionada amb l’autenticació.
# La clau secreta serveix per generar i validar sessions d’usuari,
# i el temps d’expiració indica quant duren abans de deixar de ser vàlides.
# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# Aquest bloc configura el CORS. FRONTEND_URL és l'URL del frontend de producció
# (per exemple, https://cims-web-84caf.web.app). CORS_DEV_ORIGINS permet afegir
# orígens addicionals separats per coma per a desenvolupament local
# (per exemple http://localhost:8080,http://localhost:3000).
# CORS
FRONTEND_URL=https://cims-web-84caf.web.app
CORS_DEV_ORIGINS=http://localhost:8080,http://localhost:3000

# Aquest bloc configura l'enviament de correus a través de SendGrid.
# SENDGRID_API_KEY és la clau privada de l'API. MAIL_FROM és l'adreça
# que apareix com a remitent dels correus. APP_URL és l'URL pública del backend
# i s'utilitza per construir l'enllaç de restabliment de contrasenya que s'envia
# per correu (per exemple, https://cims-backend-xxx.run.app).
# Email
SENDGRID_API_KEY=your_sendgrid_api_key
MAIL_FROM=noreply@example.com
APP_URL=http://localhost:3000
