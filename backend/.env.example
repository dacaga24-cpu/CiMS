# Configuració del servidor
PORT=3000
NODE_ENV=development

# Configuració de la base de dades MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contrasenya
DB_NAME=cims_db

# JWT Secret (canvia això per una clau segura en producció)
JWT_SECRET=la_teva_clau_secreta_super_segura_aqui
JWT_EXPIRES_IN=7d

# CORS (dominis permesos)
CORS_ORIGIN=http://localhost:8080,http://localhost:3000
