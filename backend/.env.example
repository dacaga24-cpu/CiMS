# Aquest fitxer agrupa la configuració bàsica que necessita el backend per funcionar.
# És rellevant perquè permet adaptar la connexió, el servidor i la seguretat
# sense haver de modificar directament el codi de l’aplicació.

# Aquest bloc defineix les dades necessàries per connectar el backend amb la base de dades.
# Aquí s’indica on es troba, amb quin usuari s’hi accedeix i quin nom té la base de dades utilitzada.
# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=cims_db


# Aquest bloc configura el comportament general del servidor.
# Permet indicar en quin port s’executa i en quin entorn està funcionant l’aplicació.
# Server
PORT=3000
NODE_ENV=development

# Aquest bloc defineix la configuració relacionada amb l’autenticació.
# La clau secreta serveix per generar i validar sessions d’usuari,
# i el temps d’expiració indica quant duren abans de deixar de ser vàlides.
# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
